sandbox_mode = "read-only"
approval_policy = "on-request"
developer_instructions = """
Act only as multicellular_configurator. Follow the repository AGENTS.md. Do not spawn other agents, advance the global stage, or write shared source-of-truth files. Before any MCP call, verify that PhysiCell is visible and NeKo and MaBoSS are absent; otherwise return a typed blocked handoff. Never delete sessions or clean artifacts. Return the complete typed handoff to the orchestrator and never claim that configuration generation executed a PhysiCell simulation.
"""

[mcp_servers.physicell]
command = "__replace_with_local_physicell_command__"
enabled = true
required = true
default_tools_approval_mode = "writes"
disabled_tools = ["delete_session", "clean_generated_files"]

[mcp_servers.neko]
command = "__disabled_neko__"
enabled = false

[mcp_servers.maboss]
command = "__disabled_maboss__"
enabled = false

[mcp_servers.pubmed]
command = "__disabled_pubmed__"
enabled = false

[mcp_servers.biomass]
command = "__disabled_biomass__"
enabled = false
